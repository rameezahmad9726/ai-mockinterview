# Copy to backend/.env — do not commit real secrets.

OPENAI_API_KEY=

# Transcription: OpenAI whisper-1 API (default on; fast on laptops). false = local Whisper tiny (slow on CPU).
INTERVEUX_OPENAI_WHISPER=true
# OPENAI_WHISPER_MODEL=whisper-1

# Vision pipeline (Latitude-friendly defaults also in video_processor.py)
# INTERVEUX_MAX_FRAMES=60
# INTERVEUX_SUBSAMPLE_STEP=3
# INTERVEUX_FRAME_WIDTH=480
# INTERVEUX_FRAME_HEIGHT=360

# Learned joblib scores (lightweight)
USE_LEARNED_BEHAVIOR_MODEL=true
USE_LEARNED_SPEECH_MODEL=true

# OpenAI diarization + tone (default on: split Interviewer / Interviewee). false = faster, single-block transcript.
ENABLE_TONE_ANALYSIS=true

# Optional: INTERVEUX_FAST_SPEECH=1  (first ~30s, local Whisper only)
# INTERVEUX_MAX_UPLOAD_MB=200
# INTERVEUX_DIARIZATION_TRANSCRIPT_CHARS=48000
