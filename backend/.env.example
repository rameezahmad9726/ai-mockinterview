# Copy to backend/.env — do not commit real secrets.

OPENAI_API_KEY=

# Transcription: OpenAI whisper-1 API (default on; fast on laptops). false = local Whisper tiny (slow on CPU).
INTERVEUX_OPENAI_WHISPER=true
# OPENAI_WHISPER_MODEL=whisper-1

# Vision pipeline (Latitude-friendly defaults also in video_processor.py)
# INTERVEUX_MAX_FRAMES=60
# INTERVEUX_SUBSAMPLE_STEP=3
# INTERVEUX_FRAME_WIDTH=480
# INTERVEUX_FRAME_HEIGHT=360

# Learned joblib scores (lightweight)
USE_LEARNED_BEHAVIOR_MODEL=true
USE_LEARNED_SPEECH_MODEL=true

# OpenAI diarization + tone (default on: split Interviewer / Interviewee). false = faster, single-block transcript.
ENABLE_TONE_ANALYSIS=true

# Optional: INTERVEUX_FAST_SPEECH=1  (first ~30s, local Whisper only)
# INTERVEUX_MAX_UPLOAD_MB=200
# INTERVEUX_DIARIZATION_TRANSCRIPT_CHARS=48000

# ---------- HR Automation Layer (Phase 1) ----------

# SQLite for dev; swap to Postgres in prod e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/interveux
DATABASE_URL=sqlite:///./interveux.db

# JWT signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
JWT_EXPIRES_MIN=720

# Bootstrap admin account (used by scripts/seed_admin.py). Change immediately after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FULL_NAME=Admin

# URLs used in emails and the candidate portal
APP_BASE_URL=http://localhost:3000
COMPANY_NAME=Interveux

# Email sending. Default "console" prints emails to the server log (no real delivery).
# Switch to "smtp" and fill the rest to send real mail.
EMAIL_BACKEND=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_FROM=Interveux Hiring <noreply@example.com>

# Scheduler (APScheduler). Set false to disable background jobs (e.g. in tests).
INTERVEUX_ENABLE_SCHEDULER=true
# Hour of the day (UTC) to dispatch the HR daily digest.
DIGEST_HOUR_UTC=13
